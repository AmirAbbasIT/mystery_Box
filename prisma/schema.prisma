// Catalogue schema — Phase 2a. Matches .claude/docs/09-database-schema.md and the tables already
// created in Supabase Postgres. @map/@@map keep Prisma's camelCase field names mapped onto the
// existing snake_case columns/tables rather than renaming anything in the database.
// Orders/customers/custom_requests models are deliberately not included yet — see
// .claude/docs/10-admin-panel.md's phased scope (2a catalogue, 2b custom-requests, 2c orders).

// Prisma 7: connection URLs live in prisma.config.ts (CLI/migrations) and are passed explicitly
// to the driver adapter at runtime (src/lib/db/client.ts, shared by admin services and the
// storefront's src/lib/catalogue.ts) — schema.prisma no longer takes a `url`/`directUrl`.
// See https://pris.ly/d/config-datasource.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  tagline   String
  heroImage String   @map("hero_image")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Theme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  colorSwatch String   @map("color_swatch")
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  productThemes         ProductTheme[]
  birthdayPackageThemes BirthdayPackageTheme[]

  @@map("themes")
}

model Product {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String   @unique
  name              String
  description       String
  pricePence        Int      @map("price_pence")
  categoryId        String   @map("category_id") @db.Uuid
  stock             Int      @default(0)
  active            Boolean  @default(true)
  ageSuitability    String[] @map("age_suitability")
  whatCouldBeInside String[] @map("what_could_be_inside")
  featured          Boolean  @default(false)
  seasonal          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  category            Category                    @relation(fields: [categoryId], references: [id])
  images              ProductImage[]
  themes              ProductTheme[]
  seasonalCollections SeasonalCollectionProduct[]
  orderItems          OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  src       String
  alt       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductTheme {
  productId String @map("product_id") @db.Uuid
  themeId   String @map("theme_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([productId, themeId])
  @@map("product_themes")
}

model PrizePool {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique
  name       String
  kind       String
  quantity   Int?
  pricePence Int      @map("price_pence")
  image      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  prizeItems PrizeItem[]
  orderItems OrderItem[]

  @@map("prize_pools")
}

model PrizeItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prizePoolId String  @map("prize_pool_id") @db.Uuid
  label       String
  rarity      String
  weight      Decimal @db.Decimal
  sortOrder   Int     @default(0) @map("sort_order")
  // Reserved for prize inventory — not used yet (null = unlimited). When it's enforced, a prize
  // at 0 must be excluded from draws AND from the published odds.
  stock       Int?

  prizePool   PrizePool    @relation(fields: [prizePoolId], references: [id], onDelete: Cascade)
  orderPrizes OrderPrize[]

  @@index([prizePoolId])
  @@map("prize_items")
}

model BirthdayPackage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String   @unique
  audience       String
  name           String
  description    String
  priceFromPence Int      @map("price_from_pence")
  ageRange       String?  @map("age_range")
  image          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  includes BirthdayPackageInclude[]
  themes   BirthdayPackageTheme[]

  @@map("birthday_packages")
}

model BirthdayPackageInclude {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  birthdayPackageId String @map("birthday_package_id") @db.Uuid
  label             String
  sortOrder         Int    @default(0) @map("sort_order")

  birthdayPackage BirthdayPackage @relation(fields: [birthdayPackageId], references: [id], onDelete: Cascade)

  @@index([birthdayPackageId])
  @@map("birthday_package_includes")
}

model BirthdayPackageTheme {
  birthdayPackageId String @map("birthday_package_id") @db.Uuid
  themeId           String @map("theme_id") @db.Uuid

  birthdayPackage BirthdayPackage @relation(fields: [birthdayPackageId], references: [id], onDelete: Cascade)
  theme           Theme           @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([birthdayPackageId, themeId])
  @@map("birthday_package_themes")
}

model SeasonalCollection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  description String
  startsAt    DateTime @map("starts_at") @db.Date
  endsAt      DateTime @map("ends_at") @db.Date
  heroImage   String   @map("hero_image")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products SeasonalCollectionProduct[]

  @@map("seasonal_collections")
}

model SeasonalCollectionProduct {
  seasonalCollectionId String @map("seasonal_collection_id") @db.Uuid
  productId            String @map("product_id") @db.Uuid

  seasonalCollection SeasonalCollection @relation(fields: [seasonalCollectionId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([seasonalCollectionId, productId])
  @@map("seasonal_collection_products")
}

// Singleton — exactly one row ever exists (see src/admin/services/site-settings.service.ts's
// get-or-create). Not a list-of-records entity, so it doesn't get the usual list/new/[id] admin
// CRUD pattern — see .claude/docs/10-admin-panel.md.
// Shipping is charged per order: shippingFlatPence, waived once the basket subtotal reaches
// freeShippingThresholdPence (null = never waived). Both 0/null = free shipping.
model SiteSettings {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activeColorPalette         String   @default("blush-rose") @map("active_color_palette")
  shippingFlatPence          Int      @default(0) @map("shipping_flat_pence")
  freeShippingThresholdPence Int?     @map("free_shipping_threshold_pence")
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

// Server-side snapshot of what a PayPal order was created for (items, prices, shipping, total, and
// the customer/delivery details entered on /checkout), written when the buyer clicks the PayPal
// button. Capture (src/lib/orders.ts) only proceeds if PayPal's approved amount matches totalPence
// here, and Customer/Order/OrderItem rows are built from this snapshot — never from anything the
// browser sends after approval.
model PendingCheckout {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paypalOrderId         String   @unique @map("paypal_order_id")
  // Assigned when checkout starts so it can be sent to PayPal as the invoice_id; null only for
  // checkouts started before order numbers existed.
  orderNumber           String?  @unique @map("order_number")
  items                 Json
  subtotalPence         Int      @map("subtotal_pence")
  shippingPence         Int      @map("shipping_pence")
  totalPence            Int      @map("total_pence")
  customerName          String   @map("customer_name")
  customerEmail         String   @map("customer_email")
  customerPhone         String?  @map("customer_phone")
  shippingName          String   @map("shipping_name")
  shippingLine1         String   @map("shipping_line1")
  shippingLine2         String?  @map("shipping_line2")
  shippingCity          String   @map("shipping_city")
  shippingPostcode      String   @map("shipping_postcode")
  // Coupon snapshot: no FK on purpose — capture re-checks the coupon by id and refuses (without
  // charging) if it has since been switched off, expired, used up or deleted.
  couponId              String?  @map("coupon_id") @db.Uuid
  couponCode            String?  @map("coupon_code")
  discountPence         Int      @default(0) @map("discount_pence")
  shippingDiscountPence Int      @default(0) @map("shipping_discount_pence")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pending_checkouts")
}

// Admin-managed promo codes. discountType: "percentage" (percentOff, optional maxDiscountPence
// cap), "fixed" (amountOffPence off the item subtotal) or "free_shipping". All limits optional:
// null = no limit. timesUsed only ever increases when a paid order is recorded (src/lib/orders.ts)
// — applying a code or abandoning checkout never uses one. Used coupons can't be deleted (the
// orders FK restricts it), only switched off, so order history keeps pointing at real rows.
model Coupon {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String    @unique
  note             String?
  discountType     String    @map("discount_type")
  percentOff       Int?      @map("percent_off")
  amountOffPence   Int?      @map("amount_off_pence")
  maxDiscountPence Int?      @map("max_discount_pence")
  minSubtotalPence Int?      @map("min_subtotal_pence")
  usageLimit       Int?      @map("usage_limit")
  perCustomerLimit Int?      @map("per_customer_limit")
  startsAt         DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(6)
  active           Boolean   @default(true)
  timesUsed        Int       @default(0) @map("times_used")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@map("coupons")
}

// Failed lookups for rate limiting guessing (src/lib/rate-limit.ts) — scope "coupon" (unknown promo
// codes) or "track" (order tracking lookups). clientKey is an HMAC of the visitor's IP, not the IP
// itself. Rows older than a day are pruned on insert.
model RateLimitHit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope     String
  clientKey String   @map("client_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([scope, clientKey, createdAt])
  @@map("rate_limit_hits")
}

// Phase 2c — checkout/orders. Guest checkout only (no accounts/login — see
// .claude/docs/10-admin-panel.md's Phase 2c note): Customer is a plain email-deduped record captured at
// checkout time, not an authenticated entity. Orders are created only after PayPal confirms a
// capture (src/lib/orders.ts), never optimistically, so a row here always means money was
// captured (or is pending at PayPal — status "payment_pending"). paypalOrderId is unique so the
// browser's onApprove capture and the CHECKOUT.ORDER.APPROVED webhook can race safely.
model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders Order[]

  @@map("customers")
}

// orderNumber is the customer-facing reference (e.g. "MPG-7K3Q9X") — random, not sequential, so
// it can't be used to guess other orders or reveal order volume. Status flow:
// payment_pending → paid → packing → dispatched → delivered, or cancelled / refunded.
model Order {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber           String    @unique @map("order_number")
  customerId            String    @map("customer_id") @db.Uuid
  status                String    @default("paid")
  totalPence            Int       @map("total_pence")
  shippingPence         Int       @default(0) @map("shipping_pence")
  paypalOrderId         String    @unique @map("paypal_order_id")
  paypalCaptureId       String?   @unique @map("paypal_capture_id")
  contactPhone          String?   @map("contact_phone")
  shippingName          String    @map("shipping_name")
  shippingLine1         String    @map("shipping_line1")
  shippingLine2         String?   @map("shipping_line2")
  shippingCity          String    @map("shipping_city")
  shippingPostcode      String    @map("shipping_postcode")
  shippingCountry       String    @default("GB") @map("shipping_country")
  // shippingPence is shipping before any free-shipping coupon; totalPence is what was charged:
  // items + shippingPence - discountPence - shippingDiscountPence. couponCode is a snapshot.
  couponId              String?   @map("coupon_id") @db.Uuid
  couponCode            String?   @map("coupon_code")
  discountPence         Int       @default(0) @map("discount_pence")
  shippingDiscountPence Int       @default(0) @map("shipping_discount_pence")
  // Set by staff on dispatch. carrier is a src/lib/carriers.ts id; trackingUrl is either built
  // from that carrier's template or pasted by staff.
  carrier               String?
  trackingNumber        String?   @map("tracking_number")
  trackingUrl           String?   @map("tracking_url")
  dispatchedAt          DateTime? @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt           DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  customer Customer     @relation(fields: [customerId], references: [id])
  coupon   Coupon?      @relation(fields: [couponId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  emails   OrderEmail[]

  @@index([customerId])
  @@index([couponId])
  @@map("orders")
}

// One row per customer email send attempt (src/lib/order-emails.ts). kind: "confirmation" |
// "dispatched" | "delivered"; status: "sent" | "failed". provider records which email service sent
// it, so the log stays meaningful after swapping providers. Automatic sends skip a kind that was
// already sent; staff can resend from the admin order page.
model OrderEmail {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  kind              String
  status            String
  provider          String
  providerMessageId String?  @map("provider_message_id")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_emails")
}

// productId is nullable + onDelete: SetNull deliberately — productName/unitPricePence are a
// snapshot taken at order time, so deleting a Product later must not corrupt historic order
// records (see .claude/docs/06-entities-data-model.md).
// itemType: "product" | "egg_pack" | "wheel_spin". Egg packs and wheel spins reference their
// prize pool (prizePoolId) and get their prizes drawn at payment (OrderPrize). productName is the
// display-name snapshot for every type.
model OrderItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  itemType       String  @default("product") @map("item_type")
  productId      String? @map("product_id") @db.Uuid
  prizePoolId    String? @map("prize_pool_id") @db.Uuid
  productName    String  @map("product_name")
  unitPricePence Int     @map("unit_price_pence")
  quantity       Int

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  prizePool PrizePool?   @relation(fields: [prizePoolId], references: [id], onDelete: SetNull)
  prizes    OrderPrize[]

  @@index([orderId])
  @@map("order_items")
}

// One drawn prize per egg / per spin, drawn server-side with a cryptographic RNG when payment is
// recorded (src/lib/prize-draw.ts). label/rarity/weight/totalWeight are snapshots — prize pools
// get edited (and their items recreated), but an order must keep what was actually won and the
// odds it was drawn at. position = egg/spin number within the line (1-based).
model OrderPrize {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  prizeItemId String?  @map("prize_item_id") @db.Uuid
  position    Int
  label       String
  rarity      String
  weight      Decimal  @db.Decimal
  totalWeight Decimal  @map("total_weight") @db.Decimal
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  prizeItem PrizeItem? @relation(fields: [prizeItemId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_prizes")
}

// Phase 2b — persists the birthday-builder form (CustomRequestForm), replacing its previous
// static-confirmation-only behaviour. Public writes (the customer-facing form), admin-only reads
// and status updates — see src/lib/custom-requests.ts vs src/admin/services/custom-requests.service.ts.
model CustomRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientType   String   @map("recipient_type")
  ageRange        String   @map("age_range")
  occasion        String
  themePreference String?  @map("theme_preference")
  budgetPence     Int      @map("budget_pence")
  notes           String?
  contactName     String   @map("contact_name")
  contactEmail    String   @map("contact_email")
  status          String   @default("new")
  staffNotes      String?  @map("staff_notes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("custom_requests")
}
