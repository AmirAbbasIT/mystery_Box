// Catalogue schema — Phase 2a. Matches claude/09-database-schema.md and the tables already
// created in Supabase Postgres. @map/@@map keep Prisma's camelCase field names mapped onto the
// existing snake_case columns/tables rather than renaming anything in the database.
// Orders/customers/custom_requests models are deliberately not included yet — see
// claude/10-admin-panel.md's phased scope (2a catalogue, 2b custom-requests, 2c orders).

// Prisma 7: connection URLs live in prisma.config.ts (CLI/migrations) and are passed explicitly
// to the driver adapter at runtime (src/lib/db/client.ts, shared by admin services and the
// storefront's src/lib/catalogue.ts) — schema.prisma no longer takes a `url`/`directUrl`.
// See https://pris.ly/d/config-datasource.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  tagline   String
  heroImage String   @map("hero_image")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Theme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  colorSwatch String   @map("color_swatch")
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  productThemes         ProductTheme[]
  birthdayPackageThemes BirthdayPackageTheme[]

  @@map("themes")
}

model Product {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String   @unique
  name              String
  description       String
  pricePence        Int      @map("price_pence")
  categoryId        String   @map("category_id") @db.Uuid
  stock             Int      @default(0)
  active            Boolean  @default(true)
  ageSuitability    String[] @map("age_suitability")
  whatCouldBeInside String[] @map("what_could_be_inside")
  featured          Boolean  @default(false)
  seasonal          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  category            Category                    @relation(fields: [categoryId], references: [id])
  images               ProductImage[]
  themes                ProductTheme[]
  seasonalCollections SeasonalCollectionProduct[]
  orderItems          OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  src       String
  alt       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductTheme {
  productId String @map("product_id") @db.Uuid
  themeId   String @map("theme_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([productId, themeId])
  @@map("product_themes")
}

model PrizePool {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique
  name       String
  kind       String
  quantity   Int?
  pricePence Int      @map("price_pence")
  image      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  prizeItems PrizeItem[]

  @@map("prize_pools")
}

model PrizeItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prizePoolId String  @map("prize_pool_id") @db.Uuid
  label       String
  rarity      String
  weight      Decimal @db.Decimal
  sortOrder   Int     @default(0) @map("sort_order")

  prizePool PrizePool @relation(fields: [prizePoolId], references: [id], onDelete: Cascade)

  @@index([prizePoolId])
  @@map("prize_items")
}

model BirthdayPackage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String   @unique
  audience       String
  name           String
  description    String
  priceFromPence Int      @map("price_from_pence")
  ageRange       String?  @map("age_range")
  image          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  includes BirthdayPackageInclude[]
  themes   BirthdayPackageTheme[]

  @@map("birthday_packages")
}

model BirthdayPackageInclude {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  birthdayPackageId String @map("birthday_package_id") @db.Uuid
  label             String
  sortOrder         Int    @default(0) @map("sort_order")

  birthdayPackage BirthdayPackage @relation(fields: [birthdayPackageId], references: [id], onDelete: Cascade)

  @@index([birthdayPackageId])
  @@map("birthday_package_includes")
}

model BirthdayPackageTheme {
  birthdayPackageId String @map("birthday_package_id") @db.Uuid
  themeId           String @map("theme_id") @db.Uuid

  birthdayPackage BirthdayPackage @relation(fields: [birthdayPackageId], references: [id], onDelete: Cascade)
  theme           Theme           @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([birthdayPackageId, themeId])
  @@map("birthday_package_themes")
}

model SeasonalCollection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  description String
  startsAt    DateTime @map("starts_at") @db.Date
  endsAt      DateTime @map("ends_at") @db.Date
  heroImage   String   @map("hero_image")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products SeasonalCollectionProduct[]

  @@map("seasonal_collections")
}

model SeasonalCollectionProduct {
  seasonalCollectionId String @map("seasonal_collection_id") @db.Uuid
  productId             String @map("product_id") @db.Uuid

  seasonalCollection SeasonalCollection @relation(fields: [seasonalCollectionId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([seasonalCollectionId, productId])
  @@map("seasonal_collection_products")
}

// Singleton — exactly one row ever exists (see src/admin/services/site-settings.service.ts's
// get-or-create). Not a list-of-records entity, so it doesn't get the usual list/new/[id] admin
// CRUD pattern — see claude/10-admin-panel.md.
model SiteSettings {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activeColorPalette String   @default("blush-rose") @map("active_color_palette")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

// Phase 2c — checkout/orders. Guest checkout only (no accounts/login — see
// claude/10-admin-panel.md's Phase 2c note): Customer is a plain email-deduped record captured at
// checkout time, not an authenticated entity. Orders are created only from the Stripe
// `checkout.session.completed` webhook (src/app/api/webhooks/stripe/route.ts), never optimistically
// at "proceed to checkout" time, so a row existing here always means Stripe actually confirmed
// payment. stripeCheckoutSessionId is unique specifically so the webhook handler can be idempotent
// against Stripe's at-least-once delivery retries.
model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders Order[]

  @@map("customers")
}

model Order {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId              String   @map("customer_id") @db.Uuid
  status                  String   @default("paid")
  totalPence              Int      @map("total_pence")
  stripeCheckoutSessionId String   @unique @map("stripe_checkout_session_id")
  shippingName            String   @map("shipping_name")
  shippingLine1           String   @map("shipping_line1")
  shippingLine2           String?  @map("shipping_line2")
  shippingCity            String   @map("shipping_city")
  shippingPostcode        String   @map("shipping_postcode")
  shippingCountry         String   @default("GB") @map("shipping_country")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([customerId])
  @@map("orders")
}

// productId is nullable + onDelete: SetNull deliberately — productName/unitPricePence are a
// snapshot taken at order time, so deleting a Product later must not corrupt historic order
// records (see claude/06-entities-data-model.md).
model OrderItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid
  productName    String @map("product_name")
  unitPricePence Int    @map("unit_price_pence")
  quantity       Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// Phase 2b — persists the birthday-builder form (CustomRequestForm), replacing its previous
// static-confirmation-only behaviour. Public writes (the customer-facing form), admin-only reads
// and status updates — see src/lib/custom-requests.ts vs src/admin/services/custom-requests.service.ts.
model CustomRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientType   String   @map("recipient_type")
  ageRange        String   @map("age_range")
  occasion        String
  themePreference String?  @map("theme_preference")
  budgetPence     Int      @map("budget_pence")
  notes           String?
  contactName     String   @map("contact_name")
  contactEmail    String   @map("contact_email")
  status          String   @default("new")
  staffNotes      String?  @map("staff_notes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("custom_requests")
}
