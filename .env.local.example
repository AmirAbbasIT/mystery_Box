# Copy to .env.local and fill in real values. .env.local is gitignored (see .gitignore's `.env*`
# rule) — never commit real secrets. See claude/09-database-schema.md and claude/10-admin-panel.md
# for context.

# Postgres connection strings — Project Settings > Database > Connection string in the Supabase
# dashboard. DATABASE_URL = "Transaction pooler" tab (port 6543, used at runtime by
# src/admin/db/client.ts via the Prisma driver adapter). DIRECT_URL = "Direct connection" tab
# (port 5432, used only by prisma.config.ts for migrate/generate/db pull). Both need the real DB
# password substituted in — not the same credential as SUPABASE_SECRET_KEY below.
DATABASE_URL=
DIRECT_URL=

# Not used by any code yet — Prisma (not the Supabase JS client) owns all DB queries. Kept in case
# Supabase Auth or Storage (product image uploads) get adopted later — see
# claude/10-admin-panel.md's Access control section and claude/09-database-schema.md's open
# questions. Project Settings > API Keys in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Admin PIN gate (see claude/10-admin-panel.md — Access control).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hash a PIN with: node scripts/hash-admin-pin.mjs <your-pin>
ADMIN_PIN_HASH=
# Signs the admin session cookie (jose). Generate with the same randomBytes command as above.
ADMIN_SESSION_SECRET=

# Checkout (PayPal) — REST app credentials from https://developer.paypal.com/dashboard/applications
# (Sandbox tab for testing, Live tab for production). PAYPAL_CLIENT_ID is public (it's sent to the
# browser for the PayPal buttons); PAYPAL_CLIENT_SECRET must never be exposed or prefixed with
# NEXT_PUBLIC_. PAYPAL_ENVIRONMENT is "sandbox" or "live" and must match the credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID (not a secret, but required to verify signatures) — add a webhook in the same PayPal
# app pointing at https://yourdomain.com/api/webhooks/paypal, subscribed to CHECKOUT.ORDER.APPROVED,
# PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED and
# PAYMENT.CAPTURE.REVERSED, then copy its ID here. Webhooks can't reach localhost — for local dev
# the browser-side capture is enough; the webhook is the production safety net.
PAYPAL_WEBHOOK_ID=

# Customer emails (order confirmation / dispatched / delivered) — see src/lib/email/index.ts.
# EMAIL_PROVIDER: "resend" in production, "console" locally (prints emails to the terminal instead
# of sending). RESEND_API_KEY: create a "Sending access" key restricted to your domain at
# https://resend.com/api-keys — never prefix it with NEXT_PUBLIC_. EMAIL_FROM must use the domain
# you verified in Resend. EMAIL_REPLY_TO is a real inbox you check — customer replies go there.
# SITE_URL is the public origin used for links in emails (no trailing slash).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Mystery Picked Gifts <orders@yourdomain.co.uk>"
EMAIL_REPLY_TO=hello@yourdomain.co.uk
SITE_URL=http://localhost:3000

# Secures /api/cron/keep-alive — the daily ping (vercel.json + .github/workflows/keep-alive.yml)
# that stops the free-tier Supabase project auto-pausing after 7 days of low activity. Set it in
# Vercel's Production env vars (Vercel then sends it as the cron's Authorization header
# automatically) and as the CRON_SECRET GitHub Actions secret. Generate with the randomBytes
# command above.
CRON_SECRET=
